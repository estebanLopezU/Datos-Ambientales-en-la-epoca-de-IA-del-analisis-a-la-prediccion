# Base de datos local: NO sube al repo (1 GB, GitHub rechaza >100 MB).
# El historico COMPLETO esta publicado como Release: respaldo-db-2002-2026
# (db_historico_2002_2026.zip con MANIFIESTO.txt y sha256).
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm

# Secretos: NUNCA al repo publico (permiten forjar sesiones / acceder a Vercel).
# Se regeneran: .secret_key se crea solo al arrancar; .env.local lo genera
# `vercel env pull`. Ejemplos seguros: .env.local.example, .secret_key.example.
.secret_key
.env*

# Python: binarios de cache, nunca al repo.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Datos crudos: los CSV (142 + 166 MB) y los xlsx (91 + 106 MB) superan el
# limite de 100 MB por archivo de GitHub. Estan publicados comprimidos como
# asset del Release respaldo-db-2002-2026 (datos_crudos_2002_2026.zip).
Est_Datos/
Excel_Organizado/

# Zip del respaldo (ya publicado en el Release; no duplicar en git).
# Igual los logs de tmp: solo las paginas de prueba (pagina_luna*.html) van.
tmp/*.zip
tmp/*.log
tmp/*.err

# Tenencias del servidor Apache / web y logs:
# servidor.log y servidor.err.log son legibles solo si corres el servidor
# con el script scripts/05_arrancar_servidor.ps1 (los redirige a logs/).
servidor.log
servidor.err.log

# Logs de sincronizacion/sincronizacion de la tarea del programa y
# logs de despliegue de vercel.
logs/*.log
logs/*.err
logs/_db_build.err
logs/_db_build.log
logs/_dep2.log
logs/_deploy.log
logs/_diag2.log
logs/_tok.txt
logs/_vc_login.log

# Artefactos del deploy en Vercel (regeneran automaticamente desde
# scripts/crear_db_vercel.py).
staticfiles/
db_vercel.sqlite3

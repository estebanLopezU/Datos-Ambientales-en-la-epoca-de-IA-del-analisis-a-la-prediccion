{
  "version": 2,
  "builds": [
    {
      "src": "wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "wsgi.py"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "SECRET_KEY": "dev-only-secret-change-me-via-vercel",
    "ALLOWED_HOSTS": ".vercel.app",
    "VERCEL": "1",
    "ESTCAMPUS_DB_PATH": ""
  },
  "build": {
    "env": {
      "EN_VERCEL": "1"
    }
  }
}